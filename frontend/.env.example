# =============================================
# SocioSolve-AI - Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================

# Firebase Web App configuration (from Firebase Console -> Project Settings -> Your Apps)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API base URL (default: http://localhost:8000/api; VITE_API_URL origin also supported)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000
