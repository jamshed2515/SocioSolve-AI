# =============================================
# SocioSolve-AI - Backend Environment Variables
# Copy to .env (works as-is for local development) and adjust as needed.
# NEVER commit .env or the service-account key.
# See LOCAL_SETUP.md for the full guide.
# =============================================
APP_NAME=SocioSolve-AI
# True = local development. Also allows running without the Firebase admin key (limited mode).
DEBUG=True

# ── MongoDB ──────────────────────────────────────────────
# Local MongoDB (install it, or run:  docker compose up -d mongo)
MONGODB_URI=mongodb://localhost:27017
# Or the team's shared Atlas cluster (ask a teammate for the real URI, never commit it):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=sociosolve

# ── Firebase Admin SDK ───────────────────────────────────
# The project ID is public. The key is OPTIONAL locally: without it the backend runs in
# "limited mode" (sign-in works; logout session-revocation and password change are disabled).
FIREBASE_PROJECT_ID=sociosolve-ai
# Option A: path to the service-account key file (ask a teammate for it privately)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Option B: the key's JSON (raw or base64) in one variable - handy on hosting platforms
# FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Seconds since last sign-in allowed for password change
RECENT_LOGIN_MAX_AGE=300

FRONTEND_URL=http://localhost:5173

# ── Cloudinary (optional) ────────────────────────────────
# Leave empty locally: uploads are then saved to backend/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Module 3 Real-Time Deployment (Socket.IO / WebSockets) ──
# Mounted at /socket.io via FastAPI ASGIApp (python-socketio).
# For production deployment behind Nginx/Caddy/Cloudflare:
# - Ensure WebSocket upgrade headers are passed:
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "upgrade";
# - If scaling to multiple backend instances/replicas, configure a shared
#   message manager (e.g., redis:// or rabbitmq://) with python-socketio AsyncRedisManager.
